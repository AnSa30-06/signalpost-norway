# Copy to .env (git-ignored) and fill in. Never commit the real .env.
# Brave Search API key: website discovery for companies the registry lists no website for.
# Without it the agent still runs; it only skips search.
BRAVE_SEARCH_API_KEY=
# Optional: queries per second your Brave plan allows (free 1, Search plan up to 50).
SIGNALPOST_BRAVE_QPS=1
